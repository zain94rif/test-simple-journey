APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# PostgreSQL connection string
DATABASE_URL=postgres://helpdesk:change-me@localhost:5432/helpdesk?sslmode=disable
DB_MAX_CONNS=10

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=24h
BCRYPT_COST=12

CORS_ORIGINS=http://localhost:5173

AUTO_MIGRATE=true
AUTO_SEED=true
# Set false to seed only the demo accounts, without demo tickets/comments.
SEED_DEMO_DATA=true

# Demo accounts. Passwords are required when AUTO_SEED=true and must not be
# reused in production.
SEED_ADMIN_NAME=Admin Helpdesk
SEED_ADMIN_EMAIL=admin@helpdesk.local
SEED_ADMIN_PASSWORD=change-me-admin

SEED_AGENT_NAME=Agent Satu
SEED_AGENT_EMAIL=agent@helpdesk.local
SEED_AGENT_PASSWORD=change-me-agent

SEED_REQUESTER_NAME=Requester Satu
SEED_REQUESTER_EMAIL=requester@helpdesk.local
SEED_REQUESTER_PASSWORD=change-me-requester

# Extra demo accounts used for manual testing. Passwords default to the
# matching base account when not set.
# SEED_AGENT2_NAME=Agent Dua
# SEED_AGENT2_EMAIL=agent2@helpdesk.local
# SEED_AGENT2_PASSWORD=change-me-agent
# SEED_REQUESTER2_NAME=Requester Dua
# SEED_REQUESTER2_EMAIL=requester2@helpdesk.local
# SEED_REQUESTER2_PASSWORD=change-me-requester
# SEED_REQUESTER3_NAME=Requester Tiga
# SEED_REQUESTER3_EMAIL=requester3@helpdesk.local
# SEED_REQUESTER3_PASSWORD=change-me-requester
